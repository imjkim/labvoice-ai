# Any OpenAI-compatible endpoint. Default: local Ollama (free).
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
# qwen3:4b on Ollama is the *thinking* build (~40 s/turn); use the instruct build for voice.
LLM_MODEL=qwen3:4b-instruct
LLM_TEMPERATURE=0

# Agent
MAX_AGENT_STEPS=6
TOOL_TIMEOUT_S=10
APPROVAL_TTL_S=900

# Resilience demo: probability each LIMS tool call fails (0..1)
LIMS_FAULT_RATE=0

# Speech-to-text (faster-whisper). On a 6 GB GPU shared with the LLM, int8_float16 is safer.
# If CUDA libs give you trouble on day 1: WHISPER_DEVICE=cpu, WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
